{
  "schema_version": 2,
  "id": "example.request-policy",
  "name": "Example request policy",
  "version": "0.1.0",
  "description": "Caps output tokens and can reject a configured model before upstream transmission.",
  "author": "Sub2API example",
  "requires": {
    "sub2api": ">=0.1.179 <0.3.0",
    "plugin_protocol": 2,
    "extension_api": 1,
    "ui_bridge": 1
  },
  "capabilities": [{
    "id": "request.preprocess.v1",
    "kind": "hook",
    "platform": "openai",
    "account_type": "oauth",
    "permissions": ["request.metadata.read", "request.body.read", "request.mutate"],
    "timeout_ms": 200,
    "failure_mode": "fail_closed",
    "synchronous": true
  }],
  "runtimes": {},
  "ui": {"entrypoint": "ui/index.html"},
  "files": {}
}
